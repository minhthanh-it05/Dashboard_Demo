# Copy to .env and fill in local values. Never commit .env.
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose uses POSTGRES_* to initialise the db container)
POSTGRES_DB=project_system
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://app:replace-me@db:5432/project_system

# Shows the "DỮ LIỆU MẪU" banner on every page
DEMO_MODE=True
# Password for users created by `manage.py seed_demo_data` (local demo only)
DEMO_USER_PASSWORD=

# Integration modes: mock (simulated data, no network) | live | disabled.
# Keep "mock" until the company and vendor authorize access; live adapters are not finished.
OPLACRM_MODE=mock
MISA_MODE=mock
INTEGRATION_HTTP_TIMEOUT_SECONDS=30

# OplaCRM - Phase 2. Leave blank until vendor/company authorizes access.
# Auth fields are not confirmed; only add what the real API documentation requires.
OPLACRM_BASE_URL=
OPLACRM_API_TOKEN=

# MISA ACT Open API - Phase 3. Leave blank until MISA/company authorizes access.
MISA_ACT_BASE_URL=https://actapp.misa.vn
MISA_APP_ID=
MISA_ACCESS_CODE=
MISA_ORG_COMPANY_CODE=
MISA_MIN_REQUEST_INTERVAL_SECONDS=1.0
